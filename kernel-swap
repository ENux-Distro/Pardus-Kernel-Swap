#!/usr/bin/env bash
set -euo pipefail

DEB_SOURCES_CONTENT="# See https://wiki.debian.org/SourcesList for more information.
deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware
deb-src http://deb.debian.org/debian trixie main contrib non-free non-free-firmware

deb http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware
deb-src http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware

deb http://security.debian.org/debian-security/ trixie-security main contrib non-free non-free-firmware
deb-src http://security.debian.org/debian-security/ trixie-security main contrib non-free non-free-firmware

# Backports allow you to install newer versions of software made available for this release
deb http://deb.debian.org/debian trixie-backports main contrib non-free non-free-firmware
deb-src http://deb.debian.org/debian trixie-backports main contrib non-free non-free-firmware
"

SOURCES="/etc/apt/sources.list"
BACKUP_SUFFIX="$(date +%Y%m%d%H%M%S)"
BACKUP="${SOURCES}.pardus-kernel-swap.override.bak-${BACKUP_SUFFIX}"
TMP_SOURCES="/tmp/debian-trixie-sources-${BACKUP_SUFFIX}.list"
SUDO=""
[ "$(id -u)" -ne 0 ] && SUDO="sudo"

# Ensure whiptail
if ! command -v whiptail >/dev/null 2>&1; then
  echo "whiptail not found — installing..."
  ${SUDO} apt-get update
  ${SUDO} apt-get install -y whiptail
fi

# Language Selection
LANG_CHOICE=$(whiptail --title "Language / Dil Seçimi" \
--menu "Choose language / Dil seçin" 12 60 2 \
"en" "English" \
"tr" "Türkçe" 3>&1 1>&2 2>&3) || exit 1

if [ "$LANG_CHOICE" = "tr" ]; then
  TITLE_MAIN="Pardus Çekirdek Değiştirici"
  TITLE_OVERRIDE="Pardus Çekirdek Değiştirici (Geçici Debian Modu)"
  TITLE_DANGER="DİKKAT"
  MSG_SELECTKERNEL="Lütfen kurulacak çekirdeği seçin"
  MSG_CONFIRM_RISK="UYARI: Bu işlem /etc/apt/sources.list dosyasını tamamen Debian Trixie depoları ile değiştirir.\n\nDevam etmek istiyor musunuz?"
  MSG_CANCELLED="İşlem iptal edildi."
  MSG_BACKUP_SAVE="Orijinal sources.list yedeklendi:"
  MSG_WRITING_SOURCES="Yeni sources.list yazılıyor..."
  MSG_UPDATING="apt güncelleniyor..."
  MSG_INSTALL_KERNEL="Çekirdek kuruluyor:"
  MSG_HEADERS="Başlık paketleri kuruluyor:"
  MSG_GRUB="GRUB güncelleniyor..."
  MSG_RESTORE="Orijinal sources.list geri yükleniyor..."
  MSG_DONE="İşlem başarıyla tamamlandı."
  MSG_SELECTED="Seçilen çekirdek:"
  MSG_INSTALL_WARN="Uyarı: paket kurulamadı, devam ediliyor."
  MSG_GRUB_NOT_FOUND="GRUB güncelleme komutu bulunamadı. Manuel çalıştırmanız gerekebilir."
else
  TITLE_MAIN="Pardus Kernel Swap"
  TITLE_OVERRIDE="Pardus Kernel Swap (Temporary Debian Mode)"
  TITLE_DANGER="WARNING"
  MSG_SELECTKERNEL="Please select the kernel to install"
  MSG_CONFIRM_RISK="WARNING: This will completely replace /etc/apt/sources.list with Debian Trixie repositories.\n\nDo you want to continue?"
  MSG_CANCELLED="Operation cancelled."
  MSG_BACKUP_SAVE="Original sources.list backed up to:"
  MSG_WRITING_SOURCES="Writing new sources.list..."
  MSG_UPDATING="Running apt update..."
  MSG_INSTALL_KERNEL="Installing kernel:"
  MSG_HEADERS="Installing headers:"
  MSG_GRUB="Updating GRUB..."
  MSG_RESTORE="Restoring original sources.list..."
  MSG_DONE="Operation completed successfully."
  MSG_SELECTED="Selected kernel:"
  MSG_INSTALL_WARN="Warning: package failed to install, continuing."
  MSG_GRUB_NOT_FOUND="No GRUB update command found. You may need to run it manually."
fi

# Centered Radiolist
MENU_ITEMS=(
  "1" "          6.12.73+deb13-amd64          " "off"
  "2" "          6.16.12+deb13-amd64          " "off"
  "3" "          6.17.8+deb13-amd64           " "off"
  "4" "          6.18.5+deb13-amd64           " "off"
)

SEL_NUM=$(whiptail --title "${TITLE_MAIN}" \
--radiolist "${MSG_SELECTKERNEL}" 16 70 6 \
"${MENU_ITEMS[@]}" 3>&1 1>&2 2>&3) || { echo "${MSG_CANCELLED}"; exit 1; }

case "$SEL_NUM" in
  1) SEL="6.12.73+deb13-amd64" ;;
  2) SEL="6.16.12+deb13-amd64" ;;
  3) SEL="6.17.8+deb13-amd64" ;;
  4) SEL="6.18.5+deb13-amd64" ;;
  *) echo "${MSG_CANCELLED}"; exit 1 ;;
esac

# Danger Confirmation
if ! whiptail --title "${TITLE_DANGER}" \
--yesno "${MSG_CONFIRM_RISK}\n\n${MSG_SELECTED} ${SEL}" 14 72; then
  echo "${MSG_CANCELLED}"
  exit 0
fi

# Trap restore
restore_sources_on_exit() {
  local rc=$?
  if [ -f "${BACKUP}" ]; then
    echo "${MSG_RESTORE}"
    ${SUDO} rm -f "${SOURCES}" || true
    ${SUDO} mv -f "${BACKUP}" "${SOURCES}" || true
    ${SUDO} apt-get update >/dev/null 2>&1 || true
  fi
  exit $rc
}
trap restore_sources_on_exit EXIT

# Backup
echo "${MSG_BACKUP_SAVE} ${BACKUP}"
${SUDO} cp -a "${SOURCES}" "${BACKUP}"

# Override safely
echo "${MSG_WRITING_SOURCES}"
printf '%s\n' "${DEB_SOURCES_CONTENT}" > "${TMP_SOURCES}"
${SUDO} mv -f "${TMP_SOURCES}" "${SOURCES}"
${SUDO} chmod 644 "${SOURCES}"

# Update
echo "${MSG_UPDATING}"
${SUDO} apt-get update

PKG_IMAGE="linux-image-${SEL}"
PKG_HEADERS="linux-headers-${SEL}"

echo "${MSG_INSTALL_KERNEL} ${PKG_IMAGE}"
${SUDO} apt-get install -y --no-install-recommends "${PKG_IMAGE}" || \
  echo "${MSG_INSTALL_WARN} ${PKG_IMAGE}"

echo "${MSG_HEADERS} ${PKG_HEADERS}"
${SUDO} apt-get install -y --no-install-recommends "${PKG_HEADERS}" || \
  echo "${MSG_INSTALL_WARN} ${PKG_HEADERS}"

# GRUB
echo "${MSG_GRUB}"
if command -v update-grub >/dev/null 2>&1; then
  ${SUDO} update-grub
elif command -v update-grub2 >/dev/null 2>&1; then
  ${SUDO} update-grub2
elif command -v grub-mkconfig >/dev/null 2>&1; then
  ${SUDO} grub-mkconfig -o /boot/grub/grub.cfg
else
  echo "${MSG_GRUB_NOT_FOUND}"
fi

# Restore manually before trap
echo "${MSG_RESTORE}"
${SUDO} rm -f "${SOURCES}" || true
${SUDO} mv -f "${BACKUP}" "${SOURCES}" || true
${SUDO} apt-get update || true

trap - EXIT

whiptail --title "${TITLE_MAIN}" \
--msgbox "${MSG_DONE}\n\n${MSG_SELECTED} ${SEL}" 10 60

exit 0
