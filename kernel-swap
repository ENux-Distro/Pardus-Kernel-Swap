#!/usr/bin/env bash

set -e

APT="apt"
UPDATE_GRUB="update-grub"
TEMP_REPO="/etc/apt/sources.list.d/debian-kernel-temp.list"
PIN_FILE="/etc/apt/preferences.d/kernel-pin"
LOG_FILE="/var/log/pardus-kernel-swap.log"

exec > >(tee -a "$LOG_FILE") 2>&1

# --- Root Check ---
if [ "$EUID" -ne 0 ]; then
    echo "Please run as root."
    exit 1
fi

CURRENT_KERNEL=$(uname -r)

# --- Language Selection ---
LANGUAGE=$(whiptail --title "Kernel Swap" --menu "Select Language / Dil Seçiniz" 15 60 2 \
"EN" "English" \
"TR" "Türkçe" \
3>&1 1>&2 2>&3) || exit 0

if [ "$LANGUAGE" = "TR" ]; then
    TITLE="Pardus Çekirdek Değiştirici"
    MENU_TEXT="Kurmak istediğiniz çekirdek sürümünü seçin:"
    CONFIRM_TEXT="Bu çekirdek kurulsun mu:"
    SUCCESS_TEXT="başarıyla kuruldu.\nKullanmak için sistemi yeniden başlatın."
    FAIL_TEXT="Çekirdek kurulumu başarısız oldu."
    CANCEL_TEXT="Çıkış"
    CURRENT_TEXT="Mevcut çekirdek:"
    REBOOT_TEXT="Sistemi şimdi yeniden başlatmak ister misiniz?"
    ALREADY_TEXT="Bu çekirdek zaten kurulu."
else
    TITLE="Pardus Kernel Swap"
    MENU_TEXT="Select kernel version to install:"
    CONFIRM_TEXT="Install this kernel:"
    SUCCESS_TEXT="installed successfully.\nReboot to use it."
    FAIL_TEXT="Kernel installation failed."
    CANCEL_TEXT="Cancel"
    CURRENT_TEXT="Current running kernel:"
    REBOOT_TEXT="Would you like to reboot now?"
    ALREADY_TEXT="This kernel is already installed."
fi

# --- Show Current Kernel ---
whiptail --msgbox "$CURRENT_TEXT $CURRENT_KERNEL" 10 60

# --- Kernel Menu ---
CHOICE=$(whiptail --title "$TITLE" --menu "$MENU_TEXT" 20 70 6 \
"6.12.73+deb13-amd64" "(LTS)" \
"6.16.12+deb13-amd64" "" \
"6.17.8+deb13-amd64" "" \
"6.18.5+deb13-amd64" "(LTS)" \
"exit" "$CANCEL_TEXT" \
3>&1 1>&2 2>&3) || exit 0

[ "$CHOICE" = "exit" ] && exit 0

# --- Check if already installed ---
if dpkg -l | grep -q "linux-image-$CHOICE"; then
    whiptail --msgbox "$ALREADY_TEXT" 10 60
    exit 0
fi

whiptail --yesno "$CONFIRM_TEXT $CHOICE ?" 10 60 || exit 0

echo "Starting kernel swap to $CHOICE"

# --- Backup GRUB ---
cp /boot/grub/grub.cfg /boot/grub/grub.cfg.bak || true

# --- Add Temporary Debian Repo ---
echo "deb http://deb.debian.org/debian trixie main" > "$TEMP_REPO"

# --- Add APT Pinning ---
cat > "$PIN_FILE" <<EOF
Package: *
Pin: release o=Debian
Pin-Priority: 100

Package: linux-image-*
Pin: release o=Debian
Pin-Priority: 1001

Package: linux-modules-*
Pin: release o=Debian
Pin-Priority: 1001
EOF

# --- Update ---
$APT update

# --- Install Kernel ---
if ! $APT install -y \
linux-image-$CHOICE \
linux-modules-$CHOICE \
linux-headers-$CHOICE; then
    whiptail --msgbox "$FAIL_TEXT" 10 60
    rm -f "$TEMP_REPO" "$PIN_FILE"
    $APT update
    exit 1
fi

# --- Update GRUB ---
$UPDATE_GRUB

# --- Cleanup ---
rm -f "$TEMP_REPO" "$PIN_FILE"
$APT update

whiptail --msgbox "Kernel $CHOICE $SUCCESS_TEXT" 10 60

# --- Reboot Prompt ---
whiptail --yesno "$REBOOT_TEXT" 10 60
if [ $? -eq 0 ]; then
    reboot
fi

exit 0
