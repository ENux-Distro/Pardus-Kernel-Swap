#!/usr/bin/env bash

set -e

TITLE="Experimental Kernel Swap (VM ONLY)"
APT="apt"

DEBIAN_SOURCES="/tmp/sources-debian.list"
PARDUS_SOURCES="/tmp/sources-pardus.list"
BACKUP="/etc/apt/sources.list.bak"

# --- Write Debian Sources ---
cat > "$DEBIAN_SOURCES" <<EOF
deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware
deb http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security/ trixie-security main contrib non-free non-free-firmware
deb http://deb.debian.org/debian trixie-backports main contrib non-free non-free-firmware
EOF

# --- Write Pardus Sources ---
cat > "$PARDUS_SOURCES" <<EOF
deb http://depo.pardus.org.tr/pardus yirmibes main contrib non-free non-free-firmware
deb http://depo.pardus.org.tr/pardus yirmibes-deb main contrib non-free non-free-firmware
deb http://depo.pardus.org.tr/guvenlik yirmibes-deb main contrib non-free non-free-firmware
EOF

# --- Kernel Menu ---
CHOICE=$(whiptail --title "$TITLE" --menu "Select Kernel Version:" 20 70 4 \
"6.16.12+deb13-amd64" "Stable" \
"6.17.8+deb13-amd64" "Testing" \
"6.18.5+deb13-amd64" "LTS" \
"exit" "Cancel" \
3>&1 1>&2 2>&3) || exit 0

[ "$CHOICE" = "exit" ] && exit 0

IMAGE="linux-image-$CHOICE"
HEADERS="linux-headers-$CHOICE"

whiptail --yesno "Switch to Debian repos and install $CHOICE ?" 10 70 || exit 0

# --- Backup current sources ---
sudo cp /etc/apt/sources.list "$BACKUP"

# --- Switch to Debian ---
sudo cp "$DEBIAN_SOURCES" /etc/apt/sources.list
sudo $APT update

# --- Install Kernel ---
sudo $APT install -y "$IMAGE" "$HEADERS"

# --- Restore Pardus ---
sudo cp "$PARDUS_SOURCES" /etc/apt/sources.list
sudo $APT update

# --- Update grub ---
sudo update-grub

whiptail --msgbox "Kernel $CHOICE installed.\nRepos restored to Pardus.\nReboot recommended." 12 70

exit 0

