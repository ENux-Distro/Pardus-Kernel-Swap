#!/usr/bin/env bash
#
# pardus-kernel-swap - Classic-style TUI for inspecting and swapping Pardus
# kernels. See README.md for the full description.
#
# Copyright (C) 2026  ENux-Distro / Pardus Kernel Swap
# License: GPL-2.0
#
set -uo pipefail

# ----------------------------------------------------------------------------
# Locate the project root and load modules.
# ----------------------------------------------------------------------------
# Resolve symlinks so the tool works when installed as /usr/bin/... -> repo.
SELF="${BASH_SOURCE[0]}"
while [ -h "$SELF" ]; do
    dir="$(cd -P "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ "$SELF" != /* ]] && SELF="$dir/$SELF"
done
PKS_ROOT="$(cd -P "$(dirname "$SELF")/.." && pwd)"
export PKS_ROOT

# shellcheck source=lib/common.sh
source "$PKS_ROOT/lib/common.sh"
# shellcheck source=lib/log.sh
source "$PKS_ROOT/lib/log.sh"
# shellcheck source=lib/i18n.sh
source "$PKS_ROOT/lib/i18n.sh"
# shellcheck source=lib/ui.sh
source "$PKS_ROOT/lib/ui.sh"
# shellcheck source=lib/kernel.sh
source "$PKS_ROOT/lib/kernel.sh"
# shellcheck source=lib/cve.sh
source "$PKS_ROOT/lib/cve.sh"
# shellcheck source=lib/download.sh
source "$PKS_ROOT/lib/download.sh"
# shellcheck source=lib/install.sh
source "$PKS_ROOT/lib/install.sh"
# shellcheck source=lib/build.sh
source "$PKS_ROOT/lib/build.sh"

# ----------------------------------------------------------------------------
# Startup checks
# ----------------------------------------------------------------------------
require_root
need_cmd whiptail jq dpkg uname
log_init
i18n_init
log_event "Startup" "$PKS_NAME $PKS_VERSION (lang=$PKS_LANG)"

# ----------------------------------------------------------------------------
# Reboot reminder, shown once at exit if anything was installed.
# ----------------------------------------------------------------------------
PKS_NEED_REBOOT=0
PKS_DID_INSTALL=0

finish() {
    if [ "$PKS_NEED_REBOOT" -eq 1 ]; then
        ui_msg "$(t reboot_reminder)" 16
    fi
    log_event "Exit"
    clear 2>/dev/null || true
}
trap finish EXIT

# ----------------------------------------------------------------------------
# Screen 1: current kernel + security status
# ----------------------------------------------------------------------------
show_status_screen() {
    local current report rc
    current="$(kernel_current)"
    log_event "Detected kernel" "$current"

    report="$(cve_report "$current")"
    rc=$?

    if [ "$rc" -eq 0 ]; then
        log_event "CVE check" "vulnerabilities found for $current"
        ui_msg "$(t status_known_msg "$current" "$report")" 20
    elif [ "$rc" -eq 1 ]; then
        log_event "CVE check" "clean for $current"
        ui_msg "$(t status_clean_msg "$current")" 14
    else
        log_warn "CVE check could not be completed"
        ui_msg "$(t status_unknown_msg "$current")" 14
    fi
}

# run_install_live FILE... - install packages with their output shown live on a
# clean terminal (so the user sees real progress instead of a frozen screen),
# while also capturing it to install.log for display if something fails.
# Returns the installer's exit status.
run_install_live() {
    local log="$PKS_WORK_DIR/install.log"
    clear
    t installing_header "$PKS_NAME"; echo
    echo
    install_deb "$@" 2>&1 | tee "$log"
    return "${PIPESTATUS[0]}"
}

# ----------------------------------------------------------------------------
# Predefined kernel install flow
# ----------------------------------------------------------------------------
install_predefined() {
    local id="$1"
    local version
    version="$(kernel_catalog_version "$id")"
    [ -n "$version" ] || { ui_msg "$(t err_unknown_id "$id")"; return; }

    # Description + advantages/disadvantages.
    ui_msg "$(kernel_catalog_description "$id")" "$PKS_DLG_HEIGHT"

    # Confirmation with current vs new.
    if ! ui_yesno "$(t confirm_install \
            "$(kernel_catalog_field "$id" label)" "$(kernel_current)" "$version")"; then
        log_event "Installation cancelled" "$version"
        ui_msg "$(t cancelled_no_changes)" 10
        return
    fi

    ensure_work_dir
    local img_url hdr_url img_dest hdr_dest
    img_url="$(dl_url_for_image "$version")"
    hdr_url="$(dl_url_for_headers "$version")"
    img_dest="$PKS_WORK_DIR/${PKS_IMAGE_PREFIX}${version}${PKS_PACKAGE_SUFFIX}"
    hdr_dest="$PKS_WORK_DIR/${PKS_HEADERS_PREFIX}${version}${PKS_PACKAGE_SUFFIX}"

    # Download image and headers, each with its own progress gauge.
    ui_gauge_cmd "$(t dl_image_gauge "$version")" dl_fetch_gauge "$img_url" "$img_dest"
    if [ ! -s "$img_dest" ]; then
        ui_msg "$(t dl_failed_msg "$img_url")" 16
        return
    fi

    ui_gauge_cmd "$(t dl_headers_gauge "$version")" dl_fetch_gauge "$hdr_url" "$hdr_dest"
    if [ ! -s "$hdr_dest" ]; then
        ui_msg "$(t dl_headers_failed_msg "$hdr_url")" 16
        return
    fi

    # Install image + headers together so apt resolves both at once, showing
    # live output on the terminal.
    if run_install_live "$img_dest" "$hdr_dest"; then
        bootloader_update >/dev/null 2>&1
        PKS_NEED_REBOOT=1
        PKS_DID_INSTALL=1
        ui_msg "$(t install_ok_msg "$version")" 14
    else
        ui_textbox_file "$(t title_install_failed "$PKS_NAME")" "$PKS_WORK_DIR/install.log"
        ui_msg "$(t install_failed_msg "$PKS_LOG_FILE")" 12
    fi
}

# ----------------------------------------------------------------------------
# Custom kernel build flow
# ----------------------------------------------------------------------------
install_custom() {
    ui_msg "$(kernel_catalog_description custom)" 18

    local url
    url="$(ui_input "$(t custom_url_prompt)" \
        "https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.1.tar.xz")" || {
        log_event "Custom build cancelled" "at URL prompt"
        return
    }
    [ -n "$url" ] || { ui_msg "$(t no_url_cancelled)" 10; return; }

    need_cmd make gcc tar
    if ! ui_yesno "$(t confirm_build "$url" "$(kernel_current)" "$PKS_BUILD_LOCALVERSION")" \
            "$(t btn_build)" "$(t btn_cancel)" 18; then
        log_event "Custom build cancelled" "$url"
        return
    fi

    ui_msg "$(t build_starting_msg "$(build_log_path)")" 14

    clear
    t build_header "$PKS_NAME"; echo
    t build_source_line "$url"; echo
    t build_log_line "$(build_log_path)"; echo
    echo

    local debdir
    if ! debdir="$(build_custom "$url")"; then
        ui_textbox_file "$(t title_build_failed "$PKS_NAME")" "$(build_log_path)"
        ui_msg "$(t build_failed_msg "$(build_log_path)")" 12
        return
    fi

    local debs
    debs="$(build_list_debs "$debdir")"
    if ! ui_yesno "$(t confirm_install_built "$debs" "$(kernel_current)")" \
            "$(t btn_install)" "$(t btn_cancel)" 18; then
        log_event "Custom install cancelled" "$debdir"
        ui_msg "$(t built_not_installed "$debdir")" 10
        return
    fi

    # Install all built packages (image + headers) in one transaction, with
    # live output on the terminal.
    local deb_array
    mapfile -t deb_array < <(build_list_debs "$debdir")
    if run_install_live "${deb_array[@]}"; then
        bootloader_update >/dev/null 2>&1
        PKS_NEED_REBOOT=1
        PKS_DID_INSTALL=1
        ui_msg "$(t custom_install_ok)" 12
    else
        ui_textbox_file "$(t title_install_failed "$PKS_NAME")" "$PKS_WORK_DIR/install.log"
        ui_msg "$(t custom_install_failed "$PKS_LOG_FILE")" 10
    fi
}

# ----------------------------------------------------------------------------
# Main menu loop
# ----------------------------------------------------------------------------
main_menu() {
    local choice
    while true; do
        mapfile -t menu_args < <(kernel_catalog_menu_args)
        choice="$(ui_menu "$(t menu_prompt)" "${menu_args[@]}")" || {
            # User chose Quit.
            return
        }
        log_event "User selected" "$choice"

        PKS_DID_INSTALL=0
        case "$choice" in
            custom) install_custom ;;
            "")     : ;;
            *)      install_predefined "$choice" ;;
        esac

        # After a successful install, let the user return to the menu or exit
        # rather than dropping straight back into it.
        if [ "$PKS_DID_INSTALL" -eq 1 ]; then
            if ui_yesno "$(t post_install_prompt)" \
                    "$(t btn_return_menu)" "$(t btn_exit)" 12; then
                continue
            fi
            return
        fi
    done
}

# ----------------------------------------------------------------------------
# Run
# ----------------------------------------------------------------------------
show_status_screen
main_menu
exit 0
